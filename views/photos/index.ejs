<%- include('../partials/header') %>

<div class="container py-4">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">All Photos</h2>
    <div class="p-1">
    <a class="btn btn-primary" href="/photos/new">+ New Photo</a>
    <a class="btn btn-success" href="/logout">LogOut</a>
    </div>
  </div>

  <% if (photos.length === 0) { %>
    <div class="alert alert-info text-center">
      No photos yet. Click <strong>New Photo</strong> to add one.
    </div>
  <% } else { %>

  <div class="row g-4">
    <% photos.forEach(photo => { %>
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm h-100">

        <img src="/uploads/<%= photo.filename %>" class="card-img-top img-fluid" alt="<%= photo.title %>" style="object-fit: cover; height: 230px;" />

        <div class="card-body d-flex flex-column">
          <h5 class="card-title text-center mb-3"><%= photo.title %></h5>

          <div class="mt-auto d-flex justify-content-between">

            <a href="/photos/<%= photo._id %>/edit" class="btn btn-sm btn-outline-secondary w-50 me-2">
              Edit
            </a>

            <form action="/photos/<%= photo._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this photo?');" class="w-50">
              <button class="btn btn-sm btn-outline-danger w-100">Delete</button>
            </form>

          </div>

        </div>
      </div>
    </div>
    <% }) %>
  </div>

  <% } %>

</div>

<%- include('../partials/footer') %>
